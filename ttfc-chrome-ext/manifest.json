{
  "manifest_version": 3,
  "name": "TOKU RPC",
  "version": "0.2.0",
  "_key_설명": "확장 ID를 고정하는 공개키. 이게 있어야 자동 설치(정책)와 수동 로드가 같은 ID(dciaobllfdcegjcdmimclgglapnhggjm)를 쓴다. 서명용 개인키(.pem)는 저장소에 없으며 로컬에만 보관한다.",
  "key": "",
  "description": "特撮配信サイト（東映特撮ファンクラブ・TSUBURAYA IMAGINATION）と Disney+ の視聴情報を Discord に表示します",
  "permissions": [
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://pc.tokusatsu-fc.jp/*",
    "https://imagination.m-78.jp/*",
    "https://www.disneyplus.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://pc.tokusatsu-fc.jp/*"
      ],
      "js": [
        "locales/ko.js",
        "locales/en.js",
        "locales/ja.js",
        "i18n.js",
        "extractors/ttfc-extract.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://imagination.m-78.jp/*"
      ],
      "js": [
        "locales/ko.js",
        "locales/en.js",
        "locales/ja.js",
        "i18n.js",
        "extractors/imagination-extract.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.disneyplus.com/*"
      ],
      "js": [
        "extractors/disneyplus-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.disneyplus.com/*"
      ],
      "js": [
        "locales/ko.js",
        "locales/en.js",
        "locales/ja.js",
        "i18n.js",
        "extractors/disneyplus-extract.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "version_name": "0.2 beta"
}
